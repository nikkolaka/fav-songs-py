# Copy to .env for local `docker compose up`.
# In the homelab these live in /opt/mediastack/.env, prefixed with LISTEN_.

# Host port mapped to the container (local dev only; behind Caddy there is no published port)
APP_PORT=8090

# Spotify application credentials, from https://developer.spotify.com/dashboard
CLIENT_ID=
CLIENT_SECRET=

# Must exactly match a redirect URI configured on the Spotify app.
# Spotify rejects `localhost` -- use 127.0.0.1 for local development.
#   local: http://127.0.0.1:8090/api/auth/callback
#   prod:  https://listen.coleopteras.org/api/auth/callback
REDIRECT_URI=http://127.0.0.1:8090/api/auth/callback

# Signs session cookies and derives the key that encrypts refresh tokens at rest.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this logs everyone out and invalidates stored refresh tokens.
SESSION_SECRET=

# Set to 1 when served over HTTPS so the session cookie carries the Secure flag.
COOKIE_SECURE=0

# Optional overrides
DEFAULT_PLAYLIST_NAME=Favourite Songs
FAVSONGS_DB_PATH=/app/data/favsongs.db
